{
	"name": "@htunesys/hexawebshare",
	"version": "0.1.0",
	"description": "A comprehensive Svelte 5 component library with DaisyUI and Tailwind CSS",
	"license": "MIT",
	"author": "hexaTune LLC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hTuneSys/hexaWebShare.git",
		"directory": "hexawebshare"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"components",
		"ui-library",
		"tailwindcss",
		"daisyui",
		"typescript",
		"component-library"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.stories.*",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"daisyui": "^5.0.0",
		"lucide-svelte": "^0.563.0",
		"svelte": ">=5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.3",
		"@storybook/addon-a11y": "^10.1.10",
		"@storybook/addon-docs": "^10.1.10",
		"@storybook/addon-svelte-csf": "^5.0.10",
		"@storybook/addon-vitest": "^10.1.10",
		"@storybook/sveltekit": "^10.1.10",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/package": "^2.5.6",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "4.1.17",
		"@tailwindcss/typography": "^0.5.19",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.0.14",
		"@vitest/coverage-v8": "^4.0.14",
		"autoprefixer": "^10.4.22",
		"daisyui": "5.5.5",
		"lucide-svelte": "^0.563.0",
		"playwright": "^1.57.0",
		"postcss": "^8.5.6",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"publint": "^0.3.15",
		"storybook": "^10.1.10",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.2",
		"vitest": "^4.0.14"
	}
}
